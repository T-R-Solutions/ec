<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd"
       default-autowire="constructor">
  <bean class="jetbrains.buildServer.coverage.CoveragePageFragment"/>

  <bean id="codeCoverageValueType" class="jetbrains.buildServer.coverage.CodeCoverageValueType"/>
  <bean class="jetbrains.buildServer.coverage.CodeCoverageAbsValueType"/>

  <bean id="coverageRenderableValueTypeProvider" class="jetbrains.buildServer.coverage.CoverageRenderableChartProvider">
    <constructor-arg index="0">
      <ref bean="codeCoverageValueType"/>
    </constructor-arg>
  </bean>
</beans>