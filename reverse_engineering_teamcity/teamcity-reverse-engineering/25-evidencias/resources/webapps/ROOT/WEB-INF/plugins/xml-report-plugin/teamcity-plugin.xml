<?xml version="1.0" encoding="UTF-8"?>
<teamcity-plugin xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:noNamespaceSchemaLocation="urn:schemas-jetbrains-com:teamcity-plugin-v1-xml">
    <info>
        <name>xml-report-plugin</name>
        <display-name>XML-based reports</display-name>
        <description>Plugin adds support for importing tests and inspections results from various XML-based reports into TeamCity</description>
        <version>239120</version>
        <vendor>
            <name>JetBrains</name>
            <url>https://www.jetbrains.com</url>
        </vendor>
    </info>
    <deployment
                use-separate-classloader="false"
                node-responsibilities-aware="true"
    />
</teamcity-plugin>
