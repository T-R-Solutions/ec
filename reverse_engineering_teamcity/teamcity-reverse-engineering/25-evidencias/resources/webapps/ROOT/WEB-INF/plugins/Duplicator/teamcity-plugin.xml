<?xml version="1.0" encoding="UTF-8"?>
<teamcity-plugin xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:noNamespaceSchemaLocation="urn:schemas-jetbrains-com:teamcity-plugin-v1-xml">
    <info>
        <name>Duplicator</name>
        <display-name>Duplicates Finder (Java)</display-name>
        <description>Finds and reports duplicates in Java code</description>
        <version>239120</version>
        <vendor>
            <name>JetBrains</name>
            <url>https://www.jetbrains.com</url>
        </vendor>
    </info>
    <deployment
                use-separate-classloader="true"
                node-responsibilities-aware="true"
    />
    <dependencies>
        <plugin name="idea-tool"/>
    </dependencies>
</teamcity-plugin>
