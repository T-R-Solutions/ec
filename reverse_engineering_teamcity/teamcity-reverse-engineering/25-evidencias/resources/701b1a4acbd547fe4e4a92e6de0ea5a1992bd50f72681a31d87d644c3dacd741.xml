<?xml version="1.0" encoding="UTF-8"?>
<!--suppress AutowiredDependenciesInspection -->
<beans
    xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
    http://www.springframework.org/schema/context
    http://www.springframework.org/schema/context/spring-context.xsd"
    xmlns:context="http://www.springframework.org/schema/context"
    default-autowire="constructor"
>
  <context:component-scan base-package="jetbrains.buildServer.pipeline"/>

  <bean class="jetbrains.buildServer.pipeline.impl.PipelineConfigurationChangesListener">
    <constructor-arg name="configActionsEventDispatcher" ref="configActionsDispatcher"/>
  </bean>
</beans>
