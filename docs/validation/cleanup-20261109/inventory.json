{
  "groups": {
    "G01": {
      "purpose": "Preservar diretório inicialmente vazio para versionamento.",
      "reason": "Função estrutural superada por código regular no mesmo diretório.",
      "evidence": [
        "ADR-002 e docs/architecture/application-layout.md: marcadores de diretórios sem código.",
        "Manifests Cargo com membros explícitos; Vite/Vitest por extensões e src/**/*.test.ts.",
        "Buscas por .gitkeep: árvore documental e manifests históricos; nenhum leitor operacional encontrado."
      ],
      "consumers": "Documentação da árvore e snapshots históricos; estes são preservados sem renovar hashes.",
      "effect": "Diretório continua presente com código; nenhum alvo de compilação/teste retirado."
    },
    "G02": {
      "purpose": "Bytecode CPython 3.13 gerado por importação dos módulos/testes.",
      "reason": "Cache derivado, dispensável e regenerável a partir das fontes mantidas.",
      "evidence": [
        "Fonte .py correspondente presente para cada .pyc; lista canônica por arquivo.",
        "catalog.sh: python3 e unittest discover em .py; imports dos harnesses por sys.path.",
        "inputs.sh exclui __pycache__; runtime.sh usa PYTHONDONTWRITEBYTECODE=1.",
        ".gitignore ignora __pycache__/ e *.py[cod]; nenhum sourceless loader encontrado nas fontes ativas."
      ],
      "consumers": "Importador CPython pode usar cache; fontes são autoridade. Não são logs/resultados de testes.",
      "effect": "Importações futuras podem recompilar; não modifica módulos, testes ou evidências de execução."
    },
    "G03": {
      "purpose": "Consulta temporária de instalação de Gitleaks/Opengrep/OSV no PATH.",
      "reason": "Guia operacional substituído pela integração nativa central e pelos guias canônicos.",
      "evidence": [
        "erase.md aponta para automate.py e scripts/security/ removidos.",
        "spec.md de scripts-verification declara consulta temporária sem consumidor operacional.",
        "scripts-inventory.md proíbe dependência operacional desse guia.",
        "Wrapper toolbox.sh e native_gates.py usam exec central; guias canônicos descrevem preparo externo, bases, ambientes e bloqueios."
      ],
      "consumers": "Somente menções textuais históricas na spec/inventário e no próprio guia; nenhuma execução/importação/empacotamento encontrada.",
      "effect": "Retirada da entrada obsoleta da raiz; bytes também arquivados em docs/validation/cleanup-20261109/retired/erase.md."
    }
  },
