+def bind_mount(source, target, readonly=False):
+    label = os.environ.get('TOOLBOX_SELINUX_LABEL', '')
+    if not label:
+        return ['--mount', f'type=bind,src={source},dst={target}' + (',readonly' if readonly else '')]
+    if label != 'private':
+        raise ValueError('TOOLBOX_SELINUX_LABEL must be empty or private')
+    source = Path(source)
+    if not source.is_absolute() or not source.is_dir() or any(c in str(source) for c in ':,\n\r'):
+        raise ValueError('SELinux bind source must be an existing absolute directory without delimiters')
+    return ['--volume', f'{source}:{target}:' + ('ro,Z' if readonly else 'rw,Z')]
+
+
 def command(image, argv, source, output, network='none', env=None, database=None):
     name = 'toolbox-' + uuid.uuid4().hex
     args = ['run', '--pull=never', '--name', name, '--init', '--read-only',
             '--user', f'{os.getuid()}:{os.getgid()}', '--cap-drop=ALL',
             '--security-opt=no-new-privileges:true', '--network', network,
             '--tmpfs', '/tmp:rw,nosuid,nodev,mode=1777', '--shm-size=256m',
-            '--mount', f'type=bind,src={source},dst=/src,readonly',
-            '--mount', f'type=bind,src={output},dst=/out',
+            *bind_mount(source, '/src', readonly=True),
+            *bind_mount(output, '/out'),
             '--workdir', '/src', '--env', 'HOME=/tmp/home', '--env', 'XDG_CACHE_HOME=/tmp/cache']
     if network != 'none':
         args += ['--add-host', 'host.docker.internal:host-gateway']
     if database:
-        args += ['--mount', f'type=bind,src={database},dst=/db,readonly']
+        args += bind_mount(database, '/db', readonly=True)
     for key, value in sorted((env or {}).items()):
         args += ['--env', f'{key}={value}']
     return name, ['docker', *args, image, *argv]
