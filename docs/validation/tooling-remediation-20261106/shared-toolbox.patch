+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+from toolbox.adapters import adapter, classify
+from toolbox.prepare import checked_download
+
+
+class SecurityAdapters(unittest.TestCase):
+    def test_download_rejects_substitution_and_missing_digest(self):
+        with tempfile.TemporaryDirectory() as tmp, patch('toolbox.prepare.fetch', return_value=b'substituted'):
+            target = Path(tmp) / 'binary'
+            with self.assertRaisesRegex(ValueError, 'mismatch'):
+                checked_download('https://example.invalid/tool', '0' * 64, target)
+            self.assertFalse(target.exists())
+            with self.assertRaisesRegex(ValueError, 'authoritative'):
+                checked_download('https://example.invalid/tool', '', target)
+
+    def classify_report(self, name, version, code, report):
+        with tempfile.TemporaryDirectory() as tmp:
+            output = Path(tmp)
+            (output / 'stdout.log').write_text(json.dumps(report))
+            return classify(adapter(name, version), {'tool_exit_code': code}, output)[0]
+
+    def test_opengrep_rejects_errors_skips_and_exit_mismatch(self):
+        clean = {'results': [], 'errors': [], 'paths': {'scanned': ['a.rs']}}
+        self.assertEqual(self.classify_report('opengrep', '1.33.1', 0, clean), 'success')
+        for report, code in [(clean, 1), (dict(clean, errors=[{}]), 0), (dict(clean, paths={'scanned': []}), 0), (dict(clean, paths={'scanned': ['a.rs'], 'skipped': ['b.rs']}), 0)]:
+            self.assertEqual(self.classify_report('opengrep', '1.33.1', code, report), 'operational_failure')
+
+    def test_opengrep_test_requires_positive_oracle(self):
+        report = {'results': {'a.yml': {'checks': {'rule': {'passed': True, 'matches': {'a.rs': {'expected_lines': [], 'reported_lines': []}}}}}}, 'config_missing_tests': [], 'config_with_errors': []}
+        self.assertEqual(self.classify_report('opengrep', '1.33.1', 0, report), 'operational_failure')
+        report['results']['a.yml']['checks']['rule']['matches']['a.rs'] = {'expected_lines': [2], 'reported_lines': [2]}
+        self.assertEqual(self.classify_report('opengrep', '1.33.1', 0, report), 'success')
+
+    def test_osv_requires_inventory_and_consistent_exit(self):
+        report = {'results': [{'source': {'path': '/src/Cargo.lock', 'type': 'lockfile'}, 'packages': [{'package': {'name': 'x', 'version': '1', 'ecosystem': 'crates.io'}}]}]}
+        self.assertEqual(self.classify_report('osv-scanner', '2.7.0', 0, report), 'success')
+        self.assertEqual(self.classify_report('osv-scanner', '2.7.0', 1, report), 'operational_failure')
+        report['results'][0]['packages'][0]['vulnerabilities'] = [{'id': 'TEST-1'}]
+        self.assertEqual(self.classify_report('osv-scanner', '2.7.0', 1, report), 'findings')
+        for malformed in ({}, {'results': []}, dict(report, errors=['failed'])):
+            self.assertEqual(self.classify_report('osv-scanner', '2.7.0', 0, malformed), 'operational_failure')
+
+    def test_offline_invocations(self):
+        argv, env = adapter('osv-scanner', '2.7.0').invocation({'config': 'osv.toml', 'database': 'a' * 64, 'max_database_age_hours': 24, 'paths': ['Cargo.lock']})
+        self.assertIn('--offline', argv)
+        self.assertNotIn('--download-offline-databases', argv)
+        self.assertEqual(env['OSV_SCANNER_LOCAL_DB_CACHE_DIRECTORY'], '/out/database')
+        argv, _ = adapter('opengrep', '1.33.1').invocation({'config': 'rules', 'paths': ['src'], 'mode': 'test'})
+        self.assertIn('--test', argv)
